# Sepolia deployer key — local / CI only. Never commit a real private key.
PRIVATE_KEY=
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Official Zama Sepolia USDC Mock + cUSDCMock
USDC_MOCK_ADDRESS=0x9b5Cd13b8eFbB58Dc25A05CF411D8056058aDFfF
CUSDC_MOCK_ADDRESS=0x7c5BF43B851c1dff1a4feE8dB225b87f2C223639

# Draw window floor. 3600s = 1 hour between keeper beginRounds (gas-friendly for reviews).
MIN_PERIOD_SECONDS=3600

# ConfidentialVaultSource replica APR (bps). Staging Morpho vault is idle-only.
RATE_BPS=500

# After deploy:sepolia, set this and run deploy:vault-source:sepolia
# VAULT_ADDRESS=
