# Sepolia deployment only. Never commit a funded private key.
PRIVATE_KEY=
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Official Zama Sepolia USDC Mock + cUSDCMock (override only if the registry changes).
USDC_MOCK_ADDRESS=0x9b5Cd13b8eFbB58Dc25A05CF411D8056058aDFfF
CUSDC_MOCK_ADDRESS=0x7c5BF43B851c1dff1a4feE8dB225b87f2C223639

# Vault configuration — demo batch bus.
# First deposit opens a 2-minute window; after it closes the keeper allocates to MockYield.
# Draw is due 3 minutes after the window closes (~5 minutes end-to-end).
DEPOSIT_WINDOW_SECONDS=120
DRAW_INTERVAL_SECONDS=180
YIELD_APR_BPS=8000
