# ── Supabase ─────────────────────────────────────────────────────────────────
# The service-role key bypasses RLS and must never reach the browser. Keep this
# file's real counterpart (.env) out of git.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Chain ────────────────────────────────────────────────────────────────────
CHAIN_ID=11155111

# Must be a provider key, NOT a keyless public endpoint. publicnode and friends serve
# eth_getLogs only for roughly the last 100 blocks and reject anything older as an
# "archive request", so they can never reach DEPLOYMENT_BLOCK. An Alchemy free plan is
# plenty here — but note it caps each eth_getLogs span at 10 blocks (see LOG_CHUNK).
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

VAULT_ADDRESS=0xdcD95B91EEadF241B7ce8c899272E164bFc2A4B2

# Block the vault was deployed in. Used for the very first run and for `npm run backfill`.
DEPLOYMENT_BLOCK=11404729

# ── Tuning ───────────────────────────────────────────────────────────────────
LOG_CHUNK=10
POLL_INTERVAL_MS=15000
CONFIRMATIONS=3

# ── Keeper (optional): allocate / harvest-encrypt / idle redraw ───────────────
# Bus draw() is permissionless — any wallet (or the Draws UI) can call it when due.
# OWNER_PRIVATE_KEY is only needed if you run the automated allocate/harvest keeper
# or owner-only idle redraws. Leave blank for indexer-only. Never commit a real key.
OWNER_PRIVATE_KEY=
KEEPER_POLL_INTERVAL_MS=30000
