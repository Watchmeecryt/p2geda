# ── Supabase ─────────────────────────────────────────────────────────────────
# The service-role key bypasses RLS and must never reach the browser. Keep this
# file's real counterpart (.env) out of git.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Chain ────────────────────────────────────────────────────────────────────
CHAIN_ID=11155111

# Must be a provider key, NOT a keyless public endpoint. publicnode and friends serve
# eth_getLogs only for roughly the last 100 blocks and reject anything older as an
# "archive request", so they can never reach DEPLOYMENT_BLOCK. An Alchemy free plan is
# plenty here — but note it caps each eth_getLogs span at 10 blocks (see LOG_CHUNK).
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

VAULT_ADDRESS=0xB92cAaBca6641E8EA43FCB2804d2f8D113dA393A

# Block the vault was deployed in. Used for the very first run and for `npm run backfill`.
DEPLOYMENT_BLOCK=11392191

# ── Tuning ───────────────────────────────────────────────────────────────────
LOG_CHUNK=10
POLL_INTERVAL_MS=15000
CONFIRMATIONS=3

# ── Keeper: Node FHE allocate / harvest-encrypt / draw (npm run keeper) ──────
# Vault owner private key — must match vault.owner(). Used for txs + ZamaSDK
# node() encrypt/publicDecrypt on Sepolia (no API key). Mainnet: set
# ZAMA_FHEVM_API_KEY / RELAYER_API_KEY and switch sepolia → mainnet in src/relayer.ts.
#
# Demo admin (Sepolia only) — same key as root README. Reviewers: copy into .env /
# Railway OWNER_PRIVATE_KEY. Do not use on mainnet.
OWNER_PRIVATE_KEY=0x35273d0406fb4ffc60439748ba596225a7b396d03ac5ae2d328b26fd7c944431
KEEPER_POLL_INTERVAL_MS=30000
